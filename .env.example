# Site branding
SITE_TITLE=AI Status Monitor
SITE_BRAND=AI Status Monitor
SITE_FOOTER_BRAND=AI Status Monitor

# UI defaults
SHOW_OVERALL_ALERT=false
DEFAULT_GROUPS_EXPANDED=true

# Detection
CHECK_POLL_INTERVAL_SECONDS=60
CHECK_CONCURRENCY=5
CHECK_TIMEOUT_MS=45000
DEGRADED_THRESHOLD_MS=10000
HISTORY_RETENTION_DAYS=30
API_HISTORY_POINTS=91

# Alert policy
ALERT_CONSECUTIVE_FAILURES=3

# SMTP email alerts (optional)
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_USE_TLS=true

# Telegram alerts and commands (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_HISTORY_DEFAULT_HOURS=24
TELEGRAM_STATUS_URL=
TELEGRAM_SCREENSHOT_URL=http://127.0.0.1:3000
